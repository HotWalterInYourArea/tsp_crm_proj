{
  "info": {
    "name": "TSP CRM — Full Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Login admin",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('has access_token', () => pm.expect(json.access_token).to.be.a('string'));",
              "pm.collectionVariables.set('adminToken', json.access_token);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {"mode": "urlencoded", "urlencoded": [
              {"key": "username", "value": "admin"},
              {"key": "password", "value": "admin123"}
            ]},
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Login head",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('headToken', pm.response.json().access_token);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {"mode": "urlencoded", "urlencoded": [
              {"key": "username", "value": "head"},
              {"key": "password", "value": "head123"}
            ]},
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Login manager",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('managerToken', pm.response.json().access_token);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {"mode": "urlencoded", "urlencoded": [
              {"key": "username", "value": "manager"},
              {"key": "password", "value": "manager123"}
            ]},
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Wrong password → 401",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {"mode": "urlencoded", "urlencoded": [
              {"key": "username", "value": "admin"},
              {"key": "password", "value": "wrongpass"}
            ]},
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        }
      ]
    },
    {
      "name": "1. Discovery",
      "item": [
        {
          "name": "GET /roles (admin) → save managerRoleId",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const roles = pm.response.json();",
              "const mgr = roles.find(r => r.name === 'Менеджер');",
              "pm.test('manager role exists', () => pm.expect(mgr).to.exist);",
              "if (mgr) pm.collectionVariables.set('managerRoleId', mgr.id);",
              "const headRole = roles.find(r => r.name === 'Руководитель отдела');",
              "if (headRole) pm.collectionVariables.set('headRoleId', headRole.id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/roles", "host": ["{{baseUrl}}"], "path": ["roles"]}
          }
        },
        {
          "name": "GET /departments → save salesDeptId",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const deps = pm.response.json();",
              "const sales = deps.find(d => d.name === 'Отдел продаж');",
              "const support = deps.find(d => d.name === 'Отдел поддержки');",
              "if (sales) pm.collectionVariables.set('salesDeptId', sales.id);",
              "if (support) pm.collectionVariables.set('supportDeptId', support.id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"]}
          }
        },
        {
          "name": "GET /users → save managerUserId",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const users = pm.response.json();",
              "const mgr = users.find(u => u.login === 'manager');",
              "if (mgr) pm.collectionVariables.set('managerUserId', mgr.id);",
              "const head = users.find(u => u.login === 'head');",
              "if (head) pm.collectionVariables.set('headUserId', head.id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{adminToken}}"}],
            "url": {"raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"]}
          }
        },
        {
          "name": "GET /clients → save clientId",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const cs = pm.response.json();",
              "const rom = cs.find(c => c.name === 'ООО Ромашка');",
              "if (rom) pm.collectionVariables.set('clientId', rom.id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}],
            "url": {"raw": "{{baseUrl}}/clients", "host": ["{{baseUrl}}"], "path": ["clients"]}
          }
        },
        {
          "name": "GET /pipelines → save pipelineId",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const ps = pm.response.json();",
              "if (ps[0]) pm.collectionVariables.set('pipelineId', ps[0].id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}],
            "url": {"raw": "{{baseUrl}}/pipelines", "host": ["{{baseUrl}}"], "path": ["pipelines"]}
          }
        },
        {
          "name": "GET /pipelines/{{pipelineId}}/stages → save stageId",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const ss = pm.response.json();",
              "const neg = ss.find(s => s.name === 'Переговоры') || ss[0];",
              "if (neg) pm.collectionVariables.set('stageId', neg.id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}],
            "url": {"raw": "{{baseUrl}}/pipelines/{{pipelineId}}/stages", "host": ["{{baseUrl}}"], "path": ["pipelines", "{{pipelineId}}", "stages"]}
          }
        },
        {
          "name": "GET /activity-types → save activityTypeId",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const ts = pm.response.json();",
              "const call = ts.find(t => t.name === 'Звонок') || ts[0];",
              "if (call) pm.collectionVariables.set('activityTypeId', call.id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}],
            "url": {"raw": "{{baseUrl}}/activity-types", "host": ["{{baseUrl}}"], "path": ["activity-types"]}
          }
        }
      ]
    },
    {
      "name": "2. Authorization Checks",
      "item": [
        {
          "name": "Manager POST /users → 403",
          "event": [{
            "listen": "test",
            "script": {"exec": ["pm.test('403 forbidden', () => pm.response.to.have.status(403));"], "type": "text/javascript"}
          }],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{managerToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\"name\":\"X\",\"email\":\"x@x.com\",\"login\":\"x\",\"password\":\"xxxxxx\",\"role_id\":\"{{managerRoleId}}\"}"},
            "url": {"raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"]}
          }
        },
        {
          "name": "No token GET /deals → 401",
          "event": [{
            "listen": "test",
            "script": {"exec": ["pm.test('401', () => pm.response.to.have.status(401));"], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/deals", "host": ["{{baseUrl}}"], "path": ["deals"]}
          }
        }
      ]
    },
    {
      "name": "3. Department Head",
      "item": [
        {
          "name": "Head creates user in own dept → 201",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('201 created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('headCreatedUserId', json.id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{headToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Мой Сотрудник\",\n  \"email\": \"mysubordinate@example.com\",\n  \"phone\": \"+79001234501\",\n  \"login\": \"subordinate\",\n  \"password\": \"sub12345\",\n  \"role_id\": \"{{managerRoleId}}\",\n  \"department_id\": \"{{salesDeptId}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"]}
          }
        },
        {
          "name": "Head creates user in OTHER dept → 403",
          "event": [{
            "listen": "test",
            "script": {"exec": ["pm.test('403 forbidden', () => pm.response.to.have.status(403));"], "type": "text/javascript"}
          }],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{headToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Чужой\",\n  \"email\": \"otherdept@example.com\",\n  \"phone\": \"+79001234503\",\n  \"login\": \"otheruser\",\n  \"password\": \"other123\",\n  \"role_id\": \"{{managerRoleId}}\",\n  \"department_id\": \"{{supportDeptId}}\"\n}"},
            "url": {"raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"]}
          }
        },
        {
          "name": "Head deletes subordinate → 204",
          "event": [{
            "listen": "test",
            "script": {"exec": ["pm.test('204', () => pm.response.to.have.status(204));"], "type": "text/javascript"}
          }],
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{headToken}}"}],
            "url": {"raw": "{{baseUrl}}/users/{{headCreatedUserId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{headCreatedUserId}}"]}
          }
        }
      ]
    },
    {
      "name": "4. Deals",
      "item": [
        {
          "name": "Create deal → 201",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('201 created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('newDealId', json.id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{managerToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"Постман-сделка\",\n  \"main_client_id\": \"{{clientId}}\",\n  \"assigned_by_id\": \"{{managerUserId}}\",\n  \"created_by_id\": \"{{managerUserId}}\",\n  \"pipeline_id\": \"{{pipelineId}}\",\n  \"pipeline_stage_id\": \"{{stageId}}\",\n  \"budget\": 75000,\n  \"contact_client_ids\": [],\n  \"supervisor_ids\": []\n}"},
            "url": {"raw": "{{baseUrl}}/deals", "host": ["{{baseUrl}}"], "path": ["deals"]}
          }
        },
        {
          "name": "Get deal → 200, budget matches",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('budget 75000', () => pm.expect(pm.response.json().budget).to.eql(75000));"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}],
            "url": {"raw": "{{baseUrl}}/deals/{{newDealId}}", "host": ["{{baseUrl}}"], "path": ["deals", "{{newDealId}}"]}
          }
        },
        {
          "name": "Update deal → budget 99000",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('budget 99000', () => pm.expect(pm.response.json().budget).to.eql(99000));"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{managerToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\"budget\": 99000}"},
            "url": {"raw": "{{baseUrl}}/deals/{{newDealId}}", "host": ["{{baseUrl}}"], "path": ["deals", "{{newDealId}}"]}
          }
        },
        {
          "name": "List deals contains newDealId",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const id = pm.collectionVariables.get('newDealId');",
              "pm.test('created deal is in list', () => {",
              "  pm.expect(pm.response.json().some(d => d.id === id)).to.be.true;",
              "});"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}],
            "url": {"raw": "{{baseUrl}}/deals", "host": ["{{baseUrl}}"], "path": ["deals"]}
          }
        },
        {
          "name": "Delete deal → 204",
          "event": [{
            "listen": "test",
            "script": {"exec": ["pm.test('204', () => pm.response.to.have.status(204));"], "type": "text/javascript"}
          }],
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}],
            "url": {"raw": "{{baseUrl}}/deals/{{newDealId}}", "host": ["{{baseUrl}}"], "path": ["deals", "{{newDealId}}"]}
          }
        }
      ]
    },
    {
      "name": "5. Activities + Analytics (gRPC)",
      "item": [
        {
          "name": "Create activity → 201",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('newActivityId', pm.response.json().id);"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{managerToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"description\": \"Постман-звонок\",\n  \"deal_id\": \"{{newDealId}}\",\n  \"user_id\": \"{{managerUserId}}\",\n  \"activity_type_id\": \"{{activityTypeId}}\",\n  \"deadline_at\": \"2026-12-31T23:59:59Z\"\n}"},
            "url": {"raw": "{{baseUrl}}/activities", "host": ["{{baseUrl}}"], "path": ["activities"]}
          }
        },
        {
          "name": "Analytics — commission for deal (gRPC)",
          "event": [{
            "listen": "test",
            "script": {"exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.test('has commission_amount', () => pm.expect(pm.response.json()).to.have.property('commission_amount'));"
            ], "type": "text/javascript"}
          }],
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{managerToken}}"}],
            "url": {"raw": "{{baseUrl}}/analytics/commission/{{newDealId}}?rate=0.05", "host": ["{{baseUrl}}"], "path": ["analytics", "commission", "{{newDealId}}"], "query": [{"key": "rate", "value": "0.05"}]}
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:8000"},
    {"key": "adminToken", "value": ""},
    {"key": "headToken", "value": ""},
    {"key": "managerToken", "value": ""},
    {"key": "managerRoleId", "value": ""},
    {"key": "headRoleId", "value": ""},
    {"key": "salesDeptId", "value": ""},
    {"key": "supportDeptId", "value": ""},
    {"key": "managerUserId", "value": ""},
    {"key": "headUserId", "value": ""},
    {"key": "clientId", "value": ""},
    {"key": "pipelineId", "value": ""},
    {"key": "stageId", "value": ""},
    {"key": "activityTypeId", "value": ""},
    {"key": "headCreatedUserId", "value": ""},
    {"key": "newDealId", "value": ""},
    {"key": "newActivityId", "value": ""}
  ]
}