            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/activity-types", "host": ["{{baseUrl}}"], "path": ["activity-types"] }
          }
        },
        {
          "name": "List activities for deal",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/activities?deal_id=<PASTE_DEAL_ID>", "host": ["{{baseUrl}}"], "path": ["activities"], "query": [{ "key": "deal_id", "value": "<PASTE_DEAL_ID>" }] }
          }
        },
        {
          "name": "Create activity",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Демо-звонок\",\n  \"deal_id\": \"<PASTE_DEAL_ID>\",\n  \"user_id\": \"<PASTE_MANAGER_USER_ID>\",\n  \"activity_type_id\": \"<PASTE_ACTIVITY_TYPE_ID>\",\n  \"deadline_at\": \"2026-12-31T23:59:59Z\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/activities", "host": ["{{baseUrl}}"], "path": ["activities"] }
          }
        }
      ]
