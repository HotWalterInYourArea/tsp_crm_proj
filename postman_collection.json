    {
      "name": "3. Users (admin)",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/users?limit=50", "host": ["{{baseUrl}}"], "path": ["users"], "query": [{ "key": "limit", "value": "50" }] }
          }
        },
        {
          "name": "Create user (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('newUserId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Новый Пользователь\",\n  \"email\": \"newuser@example.com\",\n  \"phone\": \"+79001234500\",\n  \"login\": \"newuser\",\n  \"password\": \"newuser123\",\n  \"role_id\": \"<PASTE_MANAGER_ROLE_ID>\",\n  \"department_id\": null\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        }
      ]
    },
    {
      "name": "4. Department Head — create/update/delete user in own dept",
      "item": [
        {
          "name": "Create user in supervised dept (head)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('headCreatedUserId', json.id);",
                  "pm.test('created in own dept', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{headToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Мой Сотрудник\",\n  \"email\": \"mysubordinate@example.com\",\n  \"phone\": \"+79001234501\",\n  \"login\": \"subordinate\",\n  \"password\": \"sub12345\",\n  \"role_id\": \"<PASTE_MANAGER_ROLE_ID>\",\n  \"department_id\": \"<PASTE_SALES_DEPT_ID>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Attempt create user in OTHER dept (head, expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{headToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Чужой\",\n  \"email\": \"otherdept@example.com\",\n  \"login\": \"other\",\n  \"password\": \"other123\",\n  \"role_id\": \"<PASTE_MANAGER_ROLE_ID>\",\n  \"department_id\": \"<PASTE_SUPPORT_DEPT_ID>\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Delete user from supervised dept (head)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{headToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/{{headCreatedUserId}}", "host": ["{{baseUrl}}"], "path": ["users", "{{headCreatedUserId}}"] }
          }
        }
      ]
    },
