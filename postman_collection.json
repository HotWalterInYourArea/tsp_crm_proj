    {
      "name": "7. Deals",
      "item": [
        {
          "name": "List deals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/deals?limit=20", "host": ["{{baseUrl}}"], "path": ["deals"], "query": [{ "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Deal stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/deals/stats", "host": ["{{baseUrl}}"], "path": ["deals", "stats"] }
          }
        },
        {
          "name": "Create deal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('newDealId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Демо-сделка\",\n  \"main_client_id\": \"<PASTE_CLIENT_ID>\",\n  \"assigned_by_id\": \"<PASTE_MANAGER_USER_ID>\",\n  \"created_by_id\": \"<PASTE_MANAGER_USER_ID>\",\n  \"pipeline_id\": \"<PASTE_PIPELINE_ID>\",\n  \"pipeline_stage_id\": \"<PASTE_STAGE_ID>\",\n  \"budget\": 100000,\n  \"contact_client_ids\": [],\n  \"supervisor_ids\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/deals", "host": ["{{baseUrl}}"], "path": ["deals"] }
          }
        },
        {
          "name": "Update deal",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"budget\": 150000, \"name\": \"Демо-сделка (обновлено)\"}" },
            "url": { "raw": "{{baseUrl}}/deals/{{newDealId}}", "host": ["{{baseUrl}}"], "path": ["deals", "{{newDealId}}"] }
          }
        },
        {
          "name": "Get deal by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/deals/{{newDealId}}", "host": ["{{baseUrl}}"], "path": ["deals", "{{newDealId}}"] }
          }
        },
        {
          "name": "Delete deal",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
            "url": { "raw": "{{baseUrl}}/deals/{{newDealId}}", "host": ["{{baseUrl}}"], "path": ["deals", "{{newDealId}}"] }
          }
        }
      ]
    },
